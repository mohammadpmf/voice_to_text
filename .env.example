# ---------- Local Whisper ----------
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float32
WHISPER_LANGUAGE=fa

# ---------- پیش‌پردازش صدا ----------
# true / false
ENABLE_HIGHPASS=true
ENABLE_NOISE_REDUCTION=true
ENABLE_NORMALIZE=true

# ---------- عمومی ----------
DEFAULT_PROVIDER=local
LOG_LEVEL=INFO